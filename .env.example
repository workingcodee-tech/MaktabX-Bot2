# ==============================================================================
# MaktabX Telegram Bot Environment Configuration
# ==============================================================================
# IMPORTANT:
# - Copy this file to '.env' for local development.
# - On Railway or production hosts, configure these in the Environment Variables tab.
# - NEVER commit real credentials, tokens, or database passwords to GitHub!
# ==============================================================================

# Required: Telegram Bot Token obtained from @BotFather
# Example: 1234567890:ABCdefGHIjklMNOpqrSTUvwxyz
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Required: Telegram numeric User ID of the primary administrator.
# Find yours using @userinfobot or @raw_data_bot on Telegram.
# Example: 987654321
ADMIN_ID=123456789

# Required: Telegram channel username or ID the user must subscribe to.
# Note: The bot MUST be added as an Administrator in this channel to verify membership.
# Example: @maktabx_channel or -1001234567890
CHANNEL_USERNAME=@your_channel_username

# Required: Official MaktabX service URL that users unlock after verification.
# Example: https://maktabx.uz
MAKTABX_URL=https://maktabx.uz

# Required / Optional: Database connection string.
# On Railway, attach a PostgreSQL plugin and use ${{Postgres.DATABASE_URL}}.
# For local development, leave empty or use sqlite:///maktabx.db for automatic SQLite fallback.
# Example: postgresql://postgres:password@roundhouse.proxy.rlwy.net:12345/railway
DATABASE_URL=sqlite:///maktabx.db

# Optional: Display name of the bot used in system messages
BOT_NAME=MaktabX Bot

# Optional: Timezone for timestamps and statistics (Default: Asia/Tashkent)
TIMEZONE=Asia/Tashkent
